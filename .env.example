# ai-forensics — environment template.
#
#   cp .env.example .env      (or just run `make env`)
#
# `.env` is git-ignored and is the ONLY place secrets belong. Every value below
# is the default that the compose file / aiforensics.config.Settings already use,
# so an untouched copy is a working configuration.

# ---------------------------------------------------------------------------
# GPU selection  ***READ THIS***
# ---------------------------------------------------------------------------
# The container is deliberately scoped to a SINGLE physical GPU: it is reserved
# one host device and nothing else (docker/docker-compose.yml ->
# deploy.resources.reservations.devices), with CUDA_VISIBLE_DEVICES set on top.
# Inside the container the one visible device is therefore always `cuda:0`,
# whichever physical GPU you picked — so never hard-code `cuda:1` in code, and
# always obtain the device from `aiforensics.get_device()`.
#
# Set this to the host GPU index you are entitled to use. On a shared machine,
# check `nvidia-smi` first and coordinate with whoever else is on the box.
AIF_GPU_ID=0

# What the python layer reports and asserts against. Changing it does NOT widen
# the container's device access — AIF_GPU_ID above controls that.
AIF_GPUS=0

# ---------------------------------------------------------------------------
# HuggingFace
# ---------------------------------------------------------------------------
# Needed for gated repos. If the bind-mounted host cache already holds a token
# file this can stay empty. NEVER commit a real token.
HF_TOKEN=

# 1 = forbid all network access and fail instead of downloading. Use this to
# prove a result was reproduced from frozen local artifacts.
HF_HUB_OFFLINE=0

# Host-side HuggingFace cache to bind-mount (models + datasets; grows large).
# Mounted read-write at /home/aif/.cache/huggingface inside the container.
AIF_HF_CACHE=${HOME}/.cache/huggingface

# ---------------------------------------------------------------------------
# torch.hub / torchvision cache  (SEPARATE from the HuggingFace cache)
# ---------------------------------------------------------------------------
# torchvision's pretrained ResNet weights are NOT HuggingFace artifacts:
# `get_state_dict()` downloads them into $TORCH_HOME/hub/checkpoints. Without this
# mount they are re-fetched on every fresh container and HF_HUB_OFFLINE=1 cannot
# cover the vision half of the testbed. Small (<250 MB), still worth persisting.
# Mounted read-write at /home/aif/.cache/torch (TORCH_HOME inside the container).
# `make up` creates this directory on the host first — if Docker creates it, it
# is owned by root and the container's `aif` user cannot write into it.
AIF_TORCH_CACHE=${HOME}/.cache/torch

# ---------------------------------------------------------------------------
# Experiment defaults (read by aiforensics.config.settings)
# ---------------------------------------------------------------------------
AIF_SEED=1337
# 1 = deterministic cuDNN/cuBLAS kernels. Slower; turn on for reportable runs.
AIF_DETERMINISTIC=0
# bfloat16 | float16 | float32 | auto. Use float16 on GPUs without bf16 support.
AIF_DTYPE=bfloat16
AIF_BATCH_SIZE=32
# Dataloader workers. Keep this modest on a shared machine.
AIF_NUM_WORKERS=8
# Thread cap for BLAS/OpenMP. Unset, every matmul spawns one thread per core.
AIF_OMP_NUM_THREADS=8

# ---------------------------------------------------------------------------
# Container / networking
# ---------------------------------------------------------------------------
# Host port for JupyterLab. Bump this if the port is already taken
# (`ss -ltnp | grep 8888`). Container-side port stays 8888.
AIF_JUPYTER_PORT=8888
# Interface the port is published on. 127.0.0.1 = reachable only through an SSH
# tunnel (recommended). Use 0.0.0.0 to expose Jupyter on the LAN.
AIF_BIND_HOST=127.0.0.1

# /dev/shm size for the container. Dataloader workers move batches through it;
# the 64 MB docker default makes multi-worker loading crash.
AIF_SHM_SIZE=32gb

# ---------------------------------------------------------------------------
# Identity — must match the HOST user that owns this checkout, otherwise files
# written from inside the container come back root-owned.
# `make env` fills these in from your live `id -u` / `id -g`.
# ---------------------------------------------------------------------------
AIF_UID=1000
AIF_GID=1000
